  "realtime": {
    "envelope": [
      "eventId",
      "tripId",
      "sequence",
      "version",
      "kind",
      "occurredAt",
      "serverTime"
    ],
    "optional": [
      "projection",
      "location",
      "etaSeconds",
      "cancelFee",
      "message"
    ],
    "kinds": [
      "trip_projection",
      "rider_cancelled",
      "driver_cancelled",
      "location",
      "driver_arrived",
      "rider_on_the_way",
      "payment_updated",
      "rating_updated",
      "message"
    ],
    "afterTerminal": [
      "payment_updated",
      "rating_updated",
      "message"
    ],
    "rules": [
      "reject sequence < 1 or blank tripId",
      "drop a seen eventId or sequence <= last seen",
      "a gap (sequence > last + 1) is accepted and triggers a resync",
      "after a terminal lifecycle status only afterTerminal kinds are accepted",
      "a location event never replaces the cached projection",
      "resync: GET /trips/{tripId} then GET /trips/{tripId}/events?after={sequence}"
    ]
  },
  "errors": {
    "shape": "{ code, message, requestId, retryable, projection? }",
    "codes": [
      "invalid_request",
      "unauthenticated",
      "forbidden",
      "not_found",
      "conflict",
